FROM nginx:alpine

# Copy static files to nginx html directory
COPY ui/index.html /usr/share/nginx/html/index.html
COPY ui/style.css /usr/share/nginx/html/style.css
COPY ui/script.js /usr/share/nginx/html/script.js

# Custom nginx config to handle SPA routing if needed (though not used here)
RUN echo "server { \
    listen 8080; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html; \
    } \
}" > /etc/nginx/conf.d/default.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
